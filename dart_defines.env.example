## Copy this file to `dart_defines.env` (DO NOT COMMIT) and fill the values.
## Then run Flutter with:
##   --dart-define-from-file=dart_defines.env
##
## Required for mobile app startup:
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
##
## Required for AI routine generation from the app (server-side):
## Use your Vercel backend (recommended) OR your LAN dev server while testing.
## Examples:
##   https://your-vercel-project.vercel.app
##   http://192.168.1.10:3000
CELIA_BACKEND_BASE_URL=https://your-vercel-project.vercel.app
##
## Optional (only needed if you use Apple Sign-In on Android):
APPLE_REDIRECT_URI=https://your-firebase-project.firebaseapp.com/auth/handler
APPLE_SERVICE_ID=com.your.service.id
##
## Feature flags (all default to on in lib/config/env.dart — set false to disable):
# ENABLE_CHAT_VOICE=true
# ENABLE_VRM_AVATAR=true
# ENABLE_VOICE_COACH=true
# ENABLE_GUIDED_WORKOUTS=true

